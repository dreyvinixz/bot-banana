# ==========================================
# 🍌 BOTBANANA / BOTTTSS ENVIRONMENT CONFIG
# ==========================================

# Credenciais Oficiais do Bot no Discord Developer Portal
DISCORD_TOKEN=seu_bot_token_aqui
CLIENT_ID=seu_client_id_aqui

# IDs dos Desenvolvedores / Administradores Supremos (separados por vírgula)
SUPERADMIN_IDS=id_admin_1,id_admin_2

# IDs dos Canais Principais do Servidor
WELCOME_PRINCIPAL_CHANNEL_ID=1528288031101026405
WELCOME_GUIA_CHANNEL_ID=1530089852106834091
ANUNCIO_CARGOS_CHANNEL_ID=1528288031101026405
IDEIAS_CHANNEL_ID=1530085098047930600
FOTOS_CHANNEL_ID=1528288033986842725
MEMES_CHANNEL_ID=1529494487729176798
COMANDOS_CHANNEL_ID=1529496411446444202

# Habilitar Privileged Intent: Server Members Intent (GUILD_MEMBERS)
ENABLE_GUILD_MEMBERS_INTENT=true

# Provedor de Inteligência Artificial para Respostas & Duelos
# Opções: "openai" ou "gemini_cli"
AI_PROVIDER=openai
OPENAI_API_KEY=sk-sua_chave_openai_aqui
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TIMEOUT_MS=60000
